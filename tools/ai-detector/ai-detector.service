[Unit]
Description=Nestoodle local Desklib AI-text check (CPU only)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=ai-detector
Group=ai-detector
WorkingDirectory=/opt/ai-detector/current
EnvironmentFile=/etc/ai-detector/env
Environment=DETECT_MODEL_DIR=/var/lib/ai-detector/model
Environment=DETECT_THREADS=2
Environment=DETECT_TIMEOUT=90
Environment=DETECT_QUANTIZE=1
Environment=HF_HOME=/var/lib/ai-detector/cache
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=DO_NOT_TRACK=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=USE_TF=0
Environment=USE_TORCH=1
ExecStart=/opt/ai-detector/current/venv/bin/python /opt/ai-detector/current/serve.py
Restart=on-failure
RestartSec=15
TimeoutStartSec=600
TimeoutStopSec=25
Nice=10
CPUQuota=200%
MemoryHigh=3G
MemoryMax=4G
MemorySwapMax=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-detector
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
